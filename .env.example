# Consola local · valores predeterminados
EVIDENCE_MODE=mock
LLM_PROVIDER=none
GOOGLE_CLOUD_PROJECT=tider-ops
GCP_CLUSTER=chaosforge-lab
GCP_LOCATION=us-central1
GCP_NAMESPACE=boutique
GCP_LOG_LIMIT=100
HISTORY_LIMIT=50

# Motor operativo opcional (API Alertmanager y evaluación)
ANTHROPIC_API_KEY=
TIDER_MODEL=                 # elegir al habilitar un modelo externo
TIDER_JUDGE_MODEL=            # opcional: otro modelo para el juez (errores menos correlacionados con el investigador)
TIDER_API_TOKEN=              # OBLIGATORIO: Bearer de la API; Alertmanager lo manda en webhook_configs.http_config.authorization
TIDER_DRY_RUN=true            # true = modo sombra: no ejecuta y escala el comando que habría corrido
TIDER_MAX_ITER=2              # rondas Investigador->Juez en total
TIDER_EXECUTOR_KUBECONFIG=    # OBLIGATORIO para ejecutar: kubeconfig de la ServiceAccount tider-executor
TIDER_READER_KUBECONFIG=      # fuera del clúster: kubeconfig de tider-reader (dentro, la SA del pod)
TIDER_AUTONOMY=on             # off = interruptor de apagado; también sirve crear el archivo $TIDER_OUT_DIR/STOP
TIDER_VERIFY_TIMEOUT=600      # segundos que el verificador espera a que la alerta se resuelva
TIDER_VERIFY_INTERVAL=30
TIDER_SLACK_WEBHOOK=          # opcional: escalamientos y PRs propuestos a Slack
TIDER_OUT_DIR=                # opcional: dónde van escalamientos, PRs y STOP (por defecto out/)
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
OPENSEARCH_URL=http://localhost:9200
ALERTMANAGER_URL=http://localhost:9093
DATABASE_URL=postgresql://tider:tider@localhost:5432/tider

# Investigación adaptativa: LLM_PROVIDER=anthropic + TIDER_MODEL explícito.
# Mantener LLM_PROVIDER=none conserva el diagnóstico por reglas.
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=90
# Opcional, solo en modelos compatibles: AGENT_MODEL_EFFORT=low (omite para usar el valor del modelo).
AGENT_LOG_BUDGET=2000
AGENT_LOGGING_TRANSPORT=sdk  # sdk o mcp; MCP requiere permisos adicionales de lectura/MCP
AGENT_READER_KUBECONFIG=     # credenciales dedicadas de lectura; no usa el contexto implícito
AGENT_KUBE_CONTEXT=         # contexto explícito del laboratorio autorizado
AGENT_METRICS_ENABLED=false
AGENT_WEB_ENABLED=false
TAVILY_API_KEY=
INVESTIGATION_HISTORY_PATH= # opcional, p. ej. out/investigations.sqlite; conserva evidencia en disco
