ANTHROPIC_API_KEY=
TIDER_MODEL=claude-sonnet-5-5
TIDER_JUDGE_MODEL=            # opcional: otro modelo para el juez (errores menos correlacionados con el investigador)
TIDER_API_TOKEN=              # OBLIGATORIO: Bearer de la API; Alertmanager lo manda en webhook_configs.http_config.authorization
TIDER_DRY_RUN=true            # true = modo sombra: no ejecuta y escala el comando que habría corrido
TIDER_MAX_ITER=2              # rondas Investigador->Juez en total
TIDER_EXECUTOR_KUBECONFIG=    # OBLIGATORIO para ejecutar: kubeconfig de la ServiceAccount tider-executor
TIDER_READER_KUBECONFIG=      # fuera del clúster: kubeconfig de tider-reader (dentro, la SA del pod)
TIDER_AUTONOMY=on             # off = interruptor de apagado; también sirve crear el archivo $TIDER_OUT_DIR/STOP
TIDER_VERIFY_TIMEOUT=600      # segundos que el verificador espera a que la alerta se resuelva
TIDER_VERIFY_INTERVAL=30
TIDER_SLACK_WEBHOOK=          # opcional: escalamientos y PRs propuestos a Slack
TIDER_OUT_DIR=                # opcional: dónde van escalamientos, PRs y STOP (por defecto out/)
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
OPENSEARCH_URL=http://localhost:9200
ALERTMANAGER_URL=http://localhost:9093
DATABASE_URL=postgresql://tider:tider@localhost:5432/tider
