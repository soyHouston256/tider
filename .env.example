# Consola local · valores predeterminados
EVIDENCE_MODE=mock
LLM_PROVIDER=none
GOOGLE_CLOUD_PROJECT=tider-ops  # id del proyecto GCP del laboratorio; cambiar por el vigente
GCP_CLUSTER=chaosforge-lab
GCP_LOCATION=us-central1
GCP_NAMESPACE=boutique
GCP_LOG_LIMIT=100
HISTORY_LIMIT=50

# Modelo (consola con LLM_PROVIDER=anthropic): ANTHROPIC_API_KEY y TIDER_MODEL.
ANTHROPIC_API_KEY=
TIDER_MODEL=                 # elegir al habilitar un modelo externo

# Investigación adaptativa: LLM_PROVIDER=anthropic + TIDER_MODEL explícito.
# Mantener LLM_PROVIDER=none conserva el diagnóstico por reglas.
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=90
# Opcional, solo en modelos compatibles: AGENT_MODEL_EFFORT=low (omite para usar el valor del modelo).
AGENT_LOG_BUDGET=2000
AGENT_LOGGING_TRANSPORT=sdk  # sdk o mcp; MCP requiere permisos adicionales de lectura/MCP
AGENT_READER_KUBECONFIG=     # credenciales dedicadas de lectura; no usa el contexto implícito
AGENT_KUBE_CONTEXT=         # contexto explícito del laboratorio autorizado
AGENT_METRICS_ENABLED=false
AGENT_EVENTS_ENABLED=true  # eventos históricos de Kubernetes vía Cloud Logging; solo lectura
AGENT_WEB_ENABLED=false
TAVILY_API_KEY=
INVESTIGATION_HISTORY_PATH= # opcional, p. ej. out/investigations.sqlite; conserva evidencia en disco
AGENT_OBSERVER_URL=         # túnel local del observador de ChaosForge, p. ej. http://127.0.0.1:8092

# Ensayo acotado de INFO/WARNING cuando los errores no explican el síntoma.
AGENT_EXPAND_LOG_ACTIVITY=false

# Pipeline v2 y piloto. Sin TIDER_PIPELINE=v2 la consola usa el pipeline v1.
TIDER_PIPELINE=v1            # v2 activa barrido, firmas, roles y juez
RECORDER_DB_PATH=            # SQLite del registrador de estado (tider-recorder)
LAKE_V3_PATH=                # carpeta del Context Lake v3 que se carga al iniciar
SWEEP_TIMEOUT_SECONDS=30     # tiempo máximo del barrido de evidencia, de 5 a 120
JUDGE_PROVIDER=openai        # openai o anthropic
JUDGE_MODEL=                 # obligatorio para la campaña del piloto
OPENAI_API_KEY=              # solo con JUDGE_PROVIDER=openai
