        <mxCell id="atlas-title" value="Modelo de datos · solicitud, evidencia y resultado" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#173C54;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="24" y="20" width="1598.0" height="45" />
        </mxCell>
        <mxCell id="atlas-question" value="¿Qué objetos viajan por la aplicación y cómo se relacionan?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#516675;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="24" y="72" width="1598.0" height="38" />
        </mxCell>
        <mxCell id="atlas-notes" value="&lt;div style=&quot;line-height:1.4;overflow-wrap:anywhere&quot;&gt;&lt;b&gt;Qué muestra&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los modelos Pydantic validan la entrada y la respuesta pública. Signal es una señal de la fuente; Evidence es el registro de una herramienta dentro del motor. Analysis reúne ambas vistas a través del resultado del flujo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Una solicitud produce un Analysis con señales, WorkflowResult y una lista ordenada de DecisionStep.&lt;br&gt;&lt;br&gt;WorkflowResult conserva hipótesis, veredicto, decisión, ejecución, reporte y auditoría.&lt;br&gt;&lt;br&gt;evidence_ids referencia Signal.id dentro del mismo resultado. Es una referencia lógica, no una clave de base de datos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Decisiones de implementación&lt;/b&gt;&lt;br&gt;&lt;br&gt;D03: validación en los bordes del caso de uso.&lt;br&gt;&lt;br&gt;D04: contrato explícito para explicar los resultados.&lt;br&gt;&lt;br&gt;&lt;b&gt;Código de referencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;src/tider/console/models.py&lt;br&gt;&lt;br&gt;src/tider/state.py&lt;br&gt;&lt;br&gt;src/tider/console/explanation.py&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=14;fontColor=#173C54;fillColor=#F3F6F8;strokeColor=#D7E1E6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1166.0" y="140" width="440" height="740" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
