          <mxGeometry as="geometry" x="24" y="72" width="2470.0" height="38" />
        </mxCell>
        <mxCell id="atlas-notes" value="&lt;div style=&quot;line-height:1.4;overflow-wrap:anywhere&quot;&gt;&lt;b&gt;Qué muestra&lt;/b&gt;&lt;br&gt;&lt;br&gt;El backend puede iniciarse con make run en el entorno virtual o como un contenedor Docker. Son dos alternativas para la misma aplicación. Los recursos del laboratorio GKE son un destino externo de consulta.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cómo leerlo&lt;/b&gt;&lt;br&gt;&lt;br&gt;El arranque nativo escucha en 127.0.0.1:8080. El navegador utiliza esa dirección para la consola y la API.&lt;br&gt;&lt;br&gt;Compose publica 127.0.0.1:8080 hacia el puerto 8080 del contenedor, cuyo usuario de ejecución es tiderops.&lt;br&gt;&lt;br&gt;El perfil lake inicia Postgres/pgvector para la entrada operativa del motor. La consola no está conectada a ese servicio.&lt;br&gt;&lt;br&gt;&lt;b&gt;Decisiones de implementación&lt;/b&gt;&lt;br&gt;&lt;br&gt;D01: misma distribución y versiones fijadas para ejecución nativa y contenedor.&lt;br&gt;&lt;br&gt;D05: acceso a GCP opcional; no se despliega un agente por cada nodo del grafo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Código de referencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;Makefile&lt;br&gt;&lt;br&gt;Dockerfile&lt;br&gt;&lt;br&gt;docker-compose.yml&lt;br&gt;&lt;br&gt;src/tider/console/__main__.py&lt;br&gt;&lt;br&gt;src/tider/api.py&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=18;fontFamily=Arial;fontSize=14;fontColor=#173C54;fillColor=#F3F6F8;strokeColor=#D7E1E6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2038.0" y="140" width="440" height="880" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
