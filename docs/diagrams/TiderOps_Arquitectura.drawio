        <mxCell id="atlas-title" value="C4 · Nivel 1: contexto del sistema" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#173C54;" vertex="1" parent="1">
