        <UserObject label="invoca contrato" mermaidId="e:AnalysisService-&gt;DiagnosticEngine#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;strokeColor=#5a7182;html=1;fontSize=16;labelBackgroundColor=light-dark(#ECECFF,#1f2020);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=#173c54;exitX=1;exitY=0.97;entryX=0.5;entryY=0;" mermaidBaseValue="invoca contrato" id="20">
