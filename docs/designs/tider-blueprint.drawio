        <mxCell id="r1" value="&lt;b&gt;1. Cartógrafo&lt;/b&gt;&lt;br&gt;código&lt;br&gt;&lt;i&gt;mapa previo desde el Lake&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
