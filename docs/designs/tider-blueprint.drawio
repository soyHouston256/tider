        <mxCell id="title" value="&lt;b&gt;Tider · roles de agentes y flujo de una investigación&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="40" as="geometry" />
        </mxCell>

        <mxCell id="r0" value="Incidente&lt;br&gt;&lt;i&gt;servicio, ventana, síntoma&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
