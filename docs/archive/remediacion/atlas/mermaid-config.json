    "clusterBorder": "#aabcc8",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#dceee9",
    "actorBorder": "#347d67",
    "actorTextColor": "#173c54",
    "signalColor": "#173c54",
    "signalTextColor": "#173c54",
